<resources>
    <style name="Theme.Aetherio" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">#55E6D1</item>
        <item name="android:windowBackground">#080F24</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.Aetherio.Starting" parent="Theme.Aetherio">
        <item name="android:windowBackground">@color/startup_background</item>
        <item name="android:statusBarColor">@color/startup_background</item>
        <item name="android:navigationBarColor">@color/startup_background</item>
    </style>
</resources>
